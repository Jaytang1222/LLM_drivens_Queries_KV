# Copy to `.env` in the repo root and fill in secrets.
# `scripts/kart.sh` loads this file automatically (never prints the key).
# Do NOT commit `.env`.

# --- Active OpenAI-compatible provider (default) ---
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-REPLACE_ME
LLM_JSON_MODE=true

# --- Optional: Google Gemini OpenAI-compatible profile ---
# Set LLM_PROVIDER=google to switch (uses the vars below).
# GOOGLE_API_KEY=
# GOOGLE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GOOGLE_LLM_MODEL=gemini-2.0-flash
