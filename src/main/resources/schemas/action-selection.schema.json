{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kart.local/schemas/action-selection.schema.json",
  "title": "ActionSelection",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_version", "proposals"],
  "properties": {
    "response_version": { "type": "string" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state_id", "action_id"],
        "properties": {
          "state_id": { "type": "string" },
          "action_id": { "type": "string" },
          "reason_code": { "type": "string" }
        }
      }
    }
  }
}
