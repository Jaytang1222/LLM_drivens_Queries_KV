# Build
target/
*.class
*.jar
!**/src/**/*.jar

# IDE / OS
*.iml
.idea/
.vscode/
.classpath
.project
.settings/
.DS_Store
*.swp
*~
.cursor/
.tmp.driveupload/

# Local / runtime (regenerable or machine-specific)
catalog/
runs/
*.log
*.out
zookeeper.out

# Accidental Windows path folders (e.g. F:\maven-repository as dir name)
F*maven-repository/

# Accidental Maven localRepository dump into project root (groupId trees)
/asm/
/avalon-framework/
/ch/
/classworlds/
/com/
/commons-*/
/info/
/io/
/javax/
/jline/
/junit/
/log4j/
/logkit/
/net/
/org/
/xmlenc/

# Secrets / local env override — NEVER commit real keys
config/environment.yaml
.env
.env.*
!.env.example

# WSL sync stamp
KART_SYNC_*
!scripts/**

# Python / editor junk
__pycache__/
*.pyc
.pytest_cache/

# Large cloned third-party trees (clone via experiments/adapters/clone-third-party.sh)
experiments/adapters/upstream/

# Raw Porto dump is huge; keep query packs only in git
datasets/porto/
datasets/ais/

# Bench run outputs (regenerated). Keep only the design workbook.
experiments/results/**
!experiments/results/experiment_design.xlsx

# Local helper scratch
scripts/_*.sh
scripts/_*.py
experiments/adapters/_poll_*.sh
experiments/adapters/_check_*.py
_tmp_*.py

# Generated by `build-fixture`
testdata/fixture-v1/

# jqwik property-test seed/cache
.jqwik-database
