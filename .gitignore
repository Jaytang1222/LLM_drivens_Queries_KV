# Build
target/
*.class
*.jar
!**/src/**/*.jar

# IDE / OS
*.iml
.idea/
.classpath
.project
.settings/
.DS_Store
*.swp
*~

# Local / runtime (regenerable or machine-specific)
catalog/
runs/
*.log
*.out
zookeeper.out

# Accidental Windows path folders (e.g. F:\maven-repository as dir name)
F*maven-repository/

# Accidental Maven localRepository dump into project root (groupId trees)
/asm/
/avalon-framework/
/ch/
/classworlds/
/com/
/commons-*/
/info/
/io/
/javax/
/jline/
/junit/
/log4j/
/logkit/
/net/
/org/
/xmlenc/

# Secrets / local env override
config/environment.yaml
.env
.env.*

# WSL sync stamp (filename = sync id; not for git)
KART_SYNC_*
!scripts/**

# Python / editor junk
__pycache__/
*.pyc
.pytest_cache/

# Large cloned upstreams (commits frozen in experiments/third_party/commits.json)
experiments/third_party/din-sql/
experiments/third_party/text-to-nosql/
experiments/third_party/bao/
experiments/third_party/llmopt/

# Bench run outputs (regenerated; keep only frozen HBase evidence in git)
experiments/results/**
!experiments/results/hbase_version_evidence.txt
!experiments/results/tdrive_smoke_report.json

# Local helper scratch (not part of formal harness)
scripts/_*.sh
scripts/_*.py
experiments/adapters/_poll_*.sh
experiments/adapters/_check_*.py

# Generated by `build-fixture`; tests build their own fixture in temporary directories.
testdata/fixture-v1/

# jqwik property-test seed/cache (regenerated on mvn test)
.jqwik-database
